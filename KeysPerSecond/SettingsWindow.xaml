<Window x:Class="KeysPerSecond.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:KeysPerSecond.Converters"
        xmlns:models="clr-namespace:KeysPerSecond.Models"
        mc:Ignorable="d"
        Title="KeysPerSecond Settings &amp; Configuration"
        Width="700" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E1017"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToBrushConverter x:Key="StringToBrush" />

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF" />
        <SolidColorBrush x:Key="AccentPink" Color="#FF007F" />
        <SolidColorBrush x:Key="CardBackground" Color="#161926" />
        <SolidColorBrush x:Key="CardBorder" Color="#272C42" />

        <!-- TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Margin="0,0,16,0"
                                Padding="12,8"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF" />
                                <Setter Property="Foreground" Value="#00E5FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#8E99AF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202438" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#313754" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D334E" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00E5FF" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Background" Value="#00E5FF" />
            <Setter Property="Foreground" Value="#07090F" />
            <Setter Property="BorderBrush" Value="#00E5FF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Background" Value="#2D1520" />
            <Setter Property="BorderBrush" Value="#FF007F" />
            <Setter Property="Foreground" Value="#FF6090" />
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151724" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2A304B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Tab Content -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#00E5FF" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                    <TextBlock Text="⚡ KPS" FontWeight="Black" FontSize="12" Foreground="#0B0D17" />
                </Border>
                <TextBlock Text="Overlay Configuration &amp; Key Mapping"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕ Exit App"
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="10,4"
                    Click="OnExitAppClick" />
        </Grid>

        <!-- TAB CONTROL -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: KEYS & BINDINGS -->
            <TabItem Header="⌨ Tracked Keys">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Keys List -->
                        <RowDefinition Height="Auto" /> <!-- Add Key Card -->
                        <RowDefinition Height="Auto" /> <!-- Presets Bar -->
                    </Grid.RowDefinitions>

                    <!-- CURRENT KEYS LIST -->
                    <Border Grid.Row="0"
                            Background="#141724"
                            BorderBrush="#252A3F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Keys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:KeyBindingConfig}">
                                        <Border Background="#1C2033"
                                                BorderBrush="#2C324E"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Accent Color Pill & Key Name -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="12" Height="12"
                                                            CornerRadius="6"
                                                            Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                                            Margin="0,0,10,0" />
                                                    <Border Background="#0D0F18" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Key}"
                                                                   FontWeight="Black"
                                                                   FontSize="13"
                                                                   Foreground="#00E5FF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label, StringFormat='Label: &quot;{0}&quot;'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E2E8F0"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,14,0" />
                                                    <TextBlock Text="{Binding VirtualKey, StringFormat='(VK: {0} / 0x{0:X2})'}"
                                                               Foreground="#707E94"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Action Buttons: Move Up, Move Down, Delete -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="▲"
                                                            Style="{StaticResource DarkButtonStyle}"
                                                            Padding="8,3"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Move Up"
                                                            Click="OnMoveKeyUpClick"
                                                            Tag="{Binding}" />
                                                    <Button Content="▼"
                                                            Style="{StaticResource DarkButtonStyle}"
                                                            Padding="8,3"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Move Down"
                                                            Click="OnMoveKeyDownClick"
                                                            Tag="{Binding}" />
                                                    <Button Content="✕ Remove"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="8,3"
                                                            ToolTip="Delete Key"
                                                            Click="OnDeleteKeyClick"
                                                            Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- ADD KEY SECTION -->
                    <Border Grid.Row="1"
                            Background="#161A2B"
                            BorderBrush="#2B324E"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="ADD NEW KEY TO OVERLAY"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#00E5FF"
                                       Margin="0,0,0,8" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Detect Key Button -->
                                <Button Grid.Column="0"
                                        Content="{Binding CaptureStatus}"
                                        Style="{StaticResource DarkButtonStyle}"
                                        BorderBrush="#00E5FF"
                                        Margin="0,0,8,0"
                                        Click="OnDetectKeyClick" />

                                <!-- Key Name / Input -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Key Name" FontSize="10" Foreground="#8A96AC" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding InputKey, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Display Label -->
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Display Label" FontSize="10" Foreground="#8A96AC" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding InputLabel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Accent Color Picker -->
                                <StackPanel Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Color" FontSize="10" Foreground="#8A96AC" Margin="0,0,4,0" />
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding InputAccentColor, Converter={StaticResource StringToBrush}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Quick Color Palette Buttons -->
                                        <Button Width="20" Height="24" Background="#00E5FF" BorderThickness="0" Margin="1,0" Click="OnPaletteColorClick" Tag="#00E5FF" ToolTip="Cyan" />
                                        <Button Width="20" Height="24" Background="#FF007F" BorderThickness="0" Margin="1,0" Click="OnPaletteColorClick" Tag="#FF007F" ToolTip="Neon Pink" />
                                        <Button Width="20" Height="24" Background="#00E676" BorderThickness="0" Margin="1,0" Click="OnPaletteColorClick" Tag="#00E676" ToolTip="Emerald" />
                                        <Button Width="20" Height="24" Background="#9D4EDD" BorderThickness="0" Margin="1,0" Click="OnPaletteColorClick" Tag="#9D4EDD" ToolTip="Purple" />
                                        <Button Width="20" Height="24" Background="#FACC15" BorderThickness="0" Margin="1,0" Click="OnPaletteColorClick" Tag="#FACC15" ToolTip="Yellow" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Add Key Button -->
                                <Button Grid.Column="4"
                                        Content="+ Add Key"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Bottom"
                                        Height="30"
                                        Click="OnAddKeyClick" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- QUICK PRESETS BAR -->
                    <Border Grid.Row="2"
                            Background="#11131E"
                            BorderBrush="#1F2336"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="QUICK PRESETS:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#6B7894"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Content="osu! 2K (Z, X)" Style="{StaticResource DarkButtonStyle}" Padding="8,3" Margin="0,0,4,0" Click="OnPresetClick" Tag="osu_2k" />
                            <Button Content="osu!mania 4K" Style="{StaticResource DarkButtonStyle}" Padding="8,3" Margin="0,0,4,0" Click="OnPresetClick" Tag="osu_4k" />
                            <Button Content="osu!mania 7K" Style="{StaticResource DarkButtonStyle}" Padding="8,3" Margin="0,0,4,0" Click="OnPresetClick" Tag="osu_7k" />
                            <Button Content="WASD" Style="{StaticResource DarkButtonStyle}" Padding="8,3" Margin="0,0,4,0" Click="OnPresetClick" Tag="wasd" />
                            <Button Content="Arrow Keys" Style="{StaticResource DarkButtonStyle}" Padding="8,3" Click="OnPresetClick" Tag="arrows" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: APPEARANCE, SIZES & SCALING -->
            <TabItem Header="🎨 Sizing, Scaling &amp; Theme">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel Orientation="Vertical">

                        <!-- OVERLAY WINDOW SCALING (ZOOM) -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Overlay Scaling (Vector Zoom)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="Scales the entire overlay sharply for 1080p, 1440p, or 4K monitors" Foreground="#7D8BA3" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding WindowScale, StringFormat='{}{0:P0}'}" FontWeight="Black" FontSize="16" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Scale Slider -->
                                <Slider Minimum="0.5" Maximum="2.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding WindowScale}" VerticalAlignment="Center" Margin="0,0,0,10" />

                                <!-- Quick Scale Buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Quick Scale:" Foreground="#7D8BA3" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="75%" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Margin="0,0,4,0" Click="OnScalePresetClick" Tag="0.75" />
                                    <Button Content="100%" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Margin="0,0,4,0" Click="OnScalePresetClick" Tag="1.0" />
                                    <Button Content="125%" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Margin="0,0,4,0" Click="OnScalePresetClick" Tag="1.25" />
                                    <Button Content="150%" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Margin="0,0,4,0" Click="OnScalePresetClick" Tag="1.5" />
                                    <Button Content="200%" Style="{StaticResource DarkButtonStyle}" Padding="8,2" Click="OnScalePresetClick" Tag="2.0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- WINDOW WIDTH & LENGTH (HEIGHT) SIZING -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Window Width &amp; Length Dimensions" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="Auto-Fit Content (Recommended)" IsChecked="{Binding AutoFit}" Foreground="#FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton Content="Custom Window Size" IsChecked="{Binding IsCustomSize}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Custom Width and Length Sliders -->
                                <StackPanel Visibility="{Binding IsCustomSize, Converter={StaticResource BoolToVis}}">
                                    <!-- Window Width Slider -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Window Width" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="160" Maximum="1000" Value="{Binding CustomWidth}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding CustomWidth, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Window Length / Height Slider -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Window Length (Height)" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="80" Maximum="600" Value="{Binding CustomHeight}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding CustomHeight, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Layout Orientation -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Layout Orientation" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Arrange keys in a horizontal row or vertical column" Foreground="#7D8BA3" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Content="Horizontal" IsChecked="{Binding IsHorizontal}" Foreground="#FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <RadioButton Content="Vertical" IsChecked="{Binding IsVertical}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Key Dimensions -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Key Switch Dimensions" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Key Width Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Key Width" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="36" Maximum="140" Value="{Binding KeyWidth}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding KeyWidth, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Key Height / Length Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Key Length (Height)" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="36" Maximum="140" Value="{Binding KeyHeight}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding KeyHeight, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Key Spacing Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Spacing Between Keys" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="2" Maximum="24" Value="{Binding KeySpacing}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding KeySpacing, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Corner Radius Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Corner Rounding" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="28" Value="{Binding CornerRadius}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding CornerRadius, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Background & Accent Colors -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Theme &amp; Colors" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Background Opacity Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Overlay Opacity" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="{Binding BackgroundOpacity}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackgroundOpacity, StringFormat='{}{0:P0}'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Global Accent Color -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Global Accent Color" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Pressed Highlight Color -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pressed Color" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Background="{Binding PressedColor, Converter={StaticResource StringToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding PressedColor, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: HOTKEYS & METRICS -->
            <TabItem Header="⚡ Hotkeys &amp; Metrics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel Orientation="Vertical">

                        <!-- Hotkeys Config -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="System Hotkeys" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Toggle Drag Mode" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Toggles click-through off to reposition" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ToggleEditModeKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Reset Metrics Hotkey" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Resets KPS, Max, and key hit counters" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ResetStatsKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HUD Display Toggles -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HUD Metrics Visibility" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                <CheckBox Content="Show Live KPS Counter &amp; Activity Bar" IsChecked="{Binding ShowKpsCounter}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <CheckBox Content="Show Peak Session Max KPS" IsChecked="{Binding ShowMaxKps}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <CheckBox Content="Show Total Keypresses Counter" IsChecked="{Binding ShowTotalCounter}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <CheckBox Content="Show Individual Counters on Each Key" IsChecked="{Binding ShowIndividualCounters}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <CheckBox Content="Show Keypress Hold Duration (e.g. 45ms)" IsChecked="{Binding ShowHoldDuration}" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <CheckBox Content="Show Keypress Hold Time Bar Animation" IsChecked="{Binding ShowHoldBar}" Foreground="#E2E8F0" />
                            </StackPanel>
                        </Border>

                        <!-- Keypress Hold Duration & Bar Configuration -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Keypress Hold Duration &amp; Bar Timing" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Max Benchmark Duration Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Full Bar Benchmark" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Press duration for 100% full bar" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="100" Maximum="1000" SmallChange="25" LargeChange="50" Value="{Binding MaxHoldDurationMs}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MaxHoldDurationMs, StringFormat='{}{0}ms'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Hold Bar Decay / Fade-Out Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fade-Out Retention" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="How long last press time stays visible" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="100" Value="{Binding HoldBarDecayMs}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding HoldBarDecayMs, StringFormat='{}{0}ms'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: WATERFALL PIANO ROLL VISUALIZER -->
            <TabItem Header="🌊 Waterfall Piano Roll">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel Orientation="Vertical">

                        <!-- Main Toggle -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Piano Roll Waterfall Bar Visualizer" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                <TextBlock Text="Ultra-low-latency, zero-allocation reactive vertical bars scrolling in rhythm game (osu!mania) style" Foreground="#7D8BA3" FontSize="11" Margin="0,0,0,12" />

                                <CheckBox Content="Enable Waterfall Piano Roll Visualizer"
                                          IsChecked="{Binding WaterfallEnabled}"
                                          Foreground="#00E5FF"
                                          FontWeight="Bold"
                                          FontSize="13"
                                          Margin="0,0,0,12" />

                                <CheckBox Content="Use Key Accent Colors (Sync note bar colors with each key)"
                                          IsChecked="{Binding WaterfallUseKeyAccentColors}"
                                          Foreground="#E2E8F0" />
                            </StackPanel>
                        </Border>

                        <!-- Scroll Direction -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Scroll Direction" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Upscroll moves notes upward from the keys; Downscroll moves them downward" Foreground="#7D8BA3" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Content="Upscroll (Upward)" IsChecked="{Binding IsUpscroll}" Foreground="#FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <RadioButton Content="Downscroll (Downward)" IsChecked="{Binding IsDownscroll}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Waterfall Dimensions & Speed -->
                        <Border Background="#161A2B" BorderBrush="#2B324E" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Visualizer Lane &amp; Scroll Dynamics" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Waterfall Height -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visualizer Height" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Vertical length of the waterfall lane" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="80" Maximum="500" SmallChange="10" LargeChange="25" Value="{Binding WaterfallHeight}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WaterfallHeight, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Scroll Speed -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Scroll Speed" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Speed in pixels per millisecond" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="2.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding WaterfallSpeed}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WaterfallSpeed, StringFormat='{}{0:F2}'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Max Visible Duration -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visible Time Window" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Cull notes older than this threshold" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="300" Maximum="3000" SmallChange="100" LargeChange="250" Value="{Binding WaterfallMaxVisibleMs}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WaterfallMaxVisibleMs, StringFormat='{}{0}ms'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Bar Opacity -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bar Opacity" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Transparency of active and moving bars" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding WaterfallOpacity}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WaterfallOpacity, StringFormat='{}{0:P0}'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Bar Corner Rounding -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bar Corner Rounding" Foreground="#CBD5E1" FontWeight="SemiBold" />
                                        <TextBlock Text="Rounded edges on moving note bars" FontSize="10" Foreground="#7D8BA3" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="16" SmallChange="1" LargeChange="2" Value="{Binding WaterfallCornerRadius}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WaterfallCornerRadius, StringFormat='{}{0}px'}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#1C2133" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="✕ Exit Application"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="OnExitAppClick" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}" Margin="0,0,8,0" Click="OnCancelClick" />
                    <Button Content="Save &amp; Apply Changes" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
